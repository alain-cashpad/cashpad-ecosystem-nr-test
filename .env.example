# Modèle de .env — copier en .env (ignoré par git) et remplir. AUCUNE valeur réelle ici.
# Détail et correspondance test ↔ variables : README.md, section « Configuration ».
# Une variable déjà exportée dans le shell prime sur ce fichier (load_dotenv n'écrase pas).

# ── Cible des tests via _target.py / _nr.py (tests customers, test_nr_*) ──
# staging (défaut) | preprod — la production n'existe pas dans la table TARGETS
NR_TARGET=staging
# 1 = autorise les tests qui ÉCRIVENT : tickets sur la caisse, config de connecteur (tickets_guard),
# et les modules en écriture hors staging (writes_guard). Laisser vide par défaut.
NR_ALLOW_WRITES=
# Partenaire lu dans ~/.config/cashpad/partners.json si APIUSER_* est vide
NR_PARTNER=obypay

# ── Partner API (auth en query string) ──
# Facultatif si ~/.config/cashpad/partners.json contient NR_PARTNER
APIUSER_EMAIL=
APIUSER_TOKEN=
INSTALLATION_ID=cashpad-8007
STAGING_BASE_URL=https://staging.cashpad.app
PREPROD_BASE_URL=https://preprod.cashpad.app

# ── Compte BO → JWT du front par POST /p/sso/public/1/sign-in ──
# Tests /cp-test BO customers (2200, 2212…) et étapes BO des test_nr_*
BOV2_STAGING_LOGIN=
BOV2_STAGING_PASSWORD=
BOV2_PREPROD_LOGIN=
BOV2_PREPROD_PASSWORD=

# ── Jetons statiques ──
# JWT du front copié depuis le dashboard (expire) : test_cp_*, repli de _nr.py
BOV2_TOKEN=
# Bearer des routes public/* analytics (≠ BOV2_TOKEN)
BOV2_STAGING_TOKEN=

# ── Caisse (VPN requis) : hôte <CASHPAD_ID>.vpn.osilia.com:9091 ──
CASHPAD_ID=cashpad-8007

# ── Collections Postman test_cp_* ──
BOV2_HOST=
BOV1_HOST=
HOST=
SITE_ID=
SLUG=
BC_CASHPAD_ID=
TARGET_01_CASHPAD_ID=
TARGET_02_CASHPAD_ID=
ORGANIZATION_ID=

# ── Optionnels ──
SEQUENTIAL_ID=
NOCAP_APIUSER_EMAIL=
NOCAP_APIUSER_TOKEN=
BOV2_STAGING_DB_URL=
PYTEST_VERBOSITY=
